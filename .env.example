# AI provider: openrouter or ollama
AI_PROVIDER=openrouter

# OpenRouter settings
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4.1

# OpenRouter reasoning settings
# Enable model reasoning when supported (viewable in CLI Agent Mode)
OPENROUTER_REASONING_ENABLED=true
# Reasoning effort level: none, minimal, low, medium, high, xhigh
OPENROUTER_REASONING_EFFORT=medium

# Prior conversation context passed back into the model (default: 1500 tokens)
RIFECLAW_MEMORY_CONTEXT_TOKENS=1500

# Ollama local settings
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional web tools
FIRECRAWL_API_KEY=

# Optional Telegram mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
