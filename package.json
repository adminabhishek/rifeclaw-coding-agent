{
  "name": "rifeclaw",
  "version": "0.0.1",
  "description": "AI coding assistant for working with a local project from CLI or Telegram.",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "developer-tools",
    "telegram-bot"
  ],
  "homepage": "https://www.npmjs.com/package/rifeclaw",
  "bin": {
    "rifeclaw": "index.ts"
  },
  "files": [
    ".env.example",
    "README.md",
    "ai",
    "doctor.ts",
    "env.ts",
    "index.ts",
    "modes",
    "project.ts",
    "setup.ts",
    "tui",
    "!**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run index.ts wakeup",
    "start": "bun run index.ts wakeup",
    "setup": "bun run index.ts setup",
    "doctor": "bun run index.ts doctor",
    "prepack": "bun run typecheck",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.7.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/core": "^1.3.0",
    "@clack/prompts": "^1.3.0",
    "@mendable/firecrawl-js": "^4.23.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@types/marked-terminal": "^6.1.1",
    "ai": "^6.0.180",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "figlet": "^1.11.0",
    "marked": "^18.0.3",
    "marked-terminal": "^7.3.0",
    "telegraf": "^4.16.3"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aestheticsuraj234/chaicodeclaw-build.git"
  },
  "bugs": {
    "url": "https://github.com/Aestheticsuraj234/chaicodeclaw-build/issues"
  }
}
