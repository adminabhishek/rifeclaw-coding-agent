{
  "name": "rifeclaw",
  "version": "0.1.6",
  "description": "AI coding assistant for working with a local project from CLI or Telegram.",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "author": "abhishek maurya",
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "developer-tools",
    "telegram-bot"
  ],
  "homepage": "https://github.com/adminabhishek/rifeclaw-coding-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminabhishek/rifeclaw-coding-agent.git"
  },
  "bugs": {
    "url": "https://github.com/adminabhishek/rifeclaw-coding-agent/issues"
  },
  "bin": {
    "rifeclaw": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "!**/*.test.ts",
    "!**/*.test.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run index.ts wakeup",
    "start": "bun run index.ts wakeup",
    "setup": "bun run index.ts setup",
    "doctor": "bun run index.ts doctor",
    "build": "bun run build.ts",
    "prepack": "bun run build && bun run typecheck",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.7.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/core": "^1.3.0",
    "@clack/prompts": "^1.3.0",
    "@mendable/firecrawl-js": "^4.23.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@types/marked-terminal": "^6.1.1",
    "ai": "^6.0.180",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "figlet": "^1.11.0",
    "marked": "^11.2.0",
    "marked-terminal": "^7.3.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  }
}
